server {
    listen 80;
    server_name monitor.vyperbd.cloud;

    root /var/www/vyperbd-monitor;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location ~* /(data|config\.php|schema\.sql)/ {
        deny all;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
